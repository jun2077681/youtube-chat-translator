{
  "name": "ylct-native-host",
  "version": "0.1.0",
  "private": true,
  "description": "Native Messaging Host for YouTube Live Chat Translator. Bridges Chrome extension to Claude Code CLI.",
  "main": "dist/host.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "start": "node dist/host.js",
    "test:smoke": "node test-smoke.js"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  }
}
